{
  "name": "footballgm-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A pro football GM game and league simulator that starts from the real post-2025 league, with every name fictional.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "pipeline"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --exclude tests/performance.test.ts && vitest run tests/performance.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build -w apps/web",
    "dev": "npm run dev -w apps/web",
    "sim": "npm run start -w apps/runner --",
    "pipeline": "npm run start -w pipeline --"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
